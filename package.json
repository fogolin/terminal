{
	"name": "firelin-terminal",
	"version": "1.1.2",
	"description": "A modern javascript terminal with a retro feel.",
	"main": "dist/firelin.min.js",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "cross-env NODE_ENV=production webpack --config webpack.config.js",
		"build:widget": "npm run build",
		"dev": "cross-env NODE_ENV=development webpack serve --config webpack.config.js --open",
		"start": "npm run dev",
		"lock": "pnpm install --lockfile-only && npm install --package-lock-only"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fogolin/firelin-terminal.git"
	},
	"keywords": [],
	"author": "Lucas Fogolin <lucas@fogol.in> (https://fogol.in)",
	"license": "GPL-3.0",
	"bugs": {
		"url": "https://github.com/fogolin/firelin-terminal/issues"
	},
	"homepage": "https://github.com/fogolin/firelin-terminal#readme",
	"devDependencies": {
		"@babel/preset-env": "^7.29.3",
		"babel-loader": "^10.1.1",
		"cross-env": "^10.1.0",
		"html-loader": "^5.1.0",
		"html-webpack-plugin": "^5.5.0",
		"webpack": "^5.106.2",
		"webpack-cli": "^7.0.2",
		"webpack-dev-server": "^5.2.3"
	}
}