	"license": "GPL-3.0",
	"bugs": {
		"url": "https://github.com/fogolin/firelin-terminal/issues"
	},
	"homepage": "https://github.com/fogolin/firelin-terminal#readme",
	"devDependencies": {
		"@babel/preset-env": "^7.29.3",
		"babel-loader": "^9.1.2",
		"cross-env": "^7.0.3",
		"css-loader": "^6.7.3",
		"html-loader": "^4.2.0",
		"html-webpack-plugin": "^5.5.0",
		"semver": "^7.3.8",
		"style-loader": "^3.3.1",
		"webpack": "^5.75.0",
		"webpack-cli": "^5.0.1",
		"webpack-dev-server": "^4.11.1"
	}
}