{
	"name": "firelin-terminal",
	"version": "1.0.0",
	"description": "A modern javascript terminal with a retro feel.",
	"main": "index.js",
	"scripts": {
		"build": "cross-env NODE_ENV=production webpack --config webpack.config.js",
		"build:widget": "npm run build",
		"dev": "cross-env NODE_ENV=development webpack serve --config webpack.config.js --open",
		"start": "npm run dev"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fogolin/firelin-terminal.git"
	},
	"keywords": [],
